{
    "Id": "BucketPolicy",
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3FULLAccess",
            "Action": "s3:*",
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::bulk-read-only",
                "arn:aws:s3:::bulk-read-only/*"
            ]
        }
    ]
}
